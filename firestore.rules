rules_version = '2';

// Reglas de HD Crédit.
// - Solo usuarios con correo y contraseña Y cuyo UID esté en la lista.
// - Los usuarios anónimos (y cualquier otro proveedor) se rechazan.
// - Todo lo que no esté listado abajo queda cerrado.
//
// AHORA: lista con los UID REALES. No publicar en hd-credit-prueba.
// NO publicar en el proyecto real hasta seguir el orden del README
// (sección "Login con correo y contraseña").
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid in [
          'R3rdDFisDjQrkLqnt1LtpS848uB2',
          'nXbh0hlxW1hu757DCQRZKgPcvDm2'
        ];
    }

    match /usuarios/compartido/{document=**} {
      allow read, write: if autorizado();
    }
  }
}
